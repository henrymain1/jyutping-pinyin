{
  "manifest_version": 3,
  "name": "Jyutping & Pinyin",
  "short_name": "Jyutping",
  "version": "1.5.0",
  "description": "Adds Cantonese jyutping next to Mandarin pinyin, and pinyin next to jyutping, on any page that shows them. Readings from CC-Canto.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Jyutping & Pinyin",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/settings.js", "src/pinyin.js", "src/jyutping.js", "src/dict.js", "src/colloquial.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-jyutping": {
      "suggested_key": { "default": "Alt+J" },
      "description": "Show or hide jyutping"
    },
    "toggle-pinyin": {
      "suggested_key": { "default": "Alt+P" },
      "description": "Show or hide pinyin"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{f4745c88-da96-4ac3-a897-03cd79b6831c}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
